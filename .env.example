# Soroban RPC endpoint to connect to. Public testnet endpoint shown; use your
# own node or a provider (e.g. a paid RPC provider) for mainnet / production.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Must match the network the RPC endpoint above actually serves.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# The Soroban contract to watch. Required — the indexer refuses to start
# without a valid-looking contract strkey (C..., 56 chars). The value below
# is Flux-toile's own placeholder; see README "Configuration" for how to
# point this at a real deployment, and "Worked example" for a live AMM.
CONTRACT_ID=CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC

# Free-text label stored alongside the contract's indexing state, purely
# for your own bookkeeping (shown in /stats and the dashboard).
CONTRACT_LABEL=

# Ledger to start indexing from on first run. Leave empty to start from
# "now" (the latest ledger at startup) instead of backfilling all history.
START_LEDGER=

# How often the indexer polls the RPC node for new ledgers, in ms.
POLL_INTERVAL_MS=5000

# Max events fetched per getEvents RPC call (pagination page size).
EVENTS_PAGE_LIMIT=100

# Max ledgers processed per indexing tick, to keep each tick bounded.
MAX_LEDGERS_PER_BATCH=2000

# How far back (in ledgers) to scan processed history for gaps each tick.
GAP_SCAN_WINDOW=100000

# Path to the SQLite database file. Directory is created if missing.
DATABASE_PATH=./data/flux-toile-indexer.sqlite

# REST API bind address/port.
API_PORT=8080
API_HOST=0.0.0.0

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# RPC retry/backoff tuning.
RPC_MAX_ATTEMPTS=5
RPC_BASE_DELAY_MS=500
RPC_MAX_DELAY_MS=15000

# Optional: path to a JSON file providing defaults for any of the above
# (env vars still take priority). See config/contracts/*.json for examples.
CONFIG_FILE=
