# Soroban RPC endpoint. Public testnet endpoint by default.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Contract to index. Required — the worker refuses to start without it.
# Example below is a placeholder; see README for how to point this at a real contract.
CONTRACT_ID=CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC

# Only used for logging/health context; does not affect RPC calls.
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Where the SQLite file lives.
DB_PATH=./data/indexer.sqlite

# Worker tuning.
POLL_INTERVAL_MS=5000
CHUNK_SIZE=2000
PAGE_LIMIT=200
ERROR_BACKOFF_MS=10000

# Ledger to start indexing from on a fresh DB. Leave unset to start from the current
# chain tip. Must be within the RPC's retention window or you'll immediately record a gap.
# START_LEDGER=

API_PORT=8787

# Set to "debug" for verbose worker logs.
LOG_LEVEL=info
