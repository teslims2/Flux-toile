{
  "name": "flux-toile-indexer",
  "version": "0.1.0",
  "description": "Off-chain event indexing service for Flux-toile and other Soroban smart contracts",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:indexer": "tsx watch src/indexer/main.ts",
    "dev:api": "tsx watch src/api/main.ts",
    "start:indexer": "node dist/indexer/main.js",
    "start:api": "node dist/api/main.js",
    "db:init": "tsx scripts/init-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck:all": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.5.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
